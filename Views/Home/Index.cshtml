@model IEnumerable<Employee>
@{
    ViewBag.Title = "Employee Directory";
}

<div class="container py-4">
    @* Header Section *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-0">Employee Directory</h4>
            <p class="text-muted small mb-0">Manage your team members and their account details.</p>
        </div>
        <a asp-controller="Home" asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-person-plus-fill me-2"></i>Add Employee
        </a>
    </div>

    @* Statistics Overview (Subtle Cards) *@
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-primary-subtle text-primary p-3 text-center">
                <div class="small fw-bold text-uppercase">Total Staff</div>
                <div class="h3 mb-0">@Model.Count()</div>
            </div>
        </div>
    </div>

    @* Main Content Card *@
    <div class="card shadow-sm border-1 border-light-subtle">
        <div class="card-header bg-white py-3">
            <div class="input-group">
                <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-search"></i></span>
                <input type="text" id="employeeSearch" class="form-control border-start-0" placeholder="Search by name, email or department...">
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-4">Employee</th>
                        <th>Contact</th>
                        <th>Department</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody id="employeeTableBody">
                    @foreach (var employee in Model)
                    {
                        var photoPath = "~/Images/" + (employee.PhotoPath ?? "noimage.png");
                        <tr class="employee-row">
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <img src="@photoPath" asp-append-version="true"
                                         class="rounded-circle border"
                                         style="width: 45px; height: 45px; object-fit: cover;"
                                         alt="@employee.Name" />
                                    <div class="ms-3">
                                        <div class="fw-bold text-dark">@employee.Name</div>
                                        <div class="text-muted small">ID: #@employee.Id</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="small">@employee.Email</div>
                            </td>
                            <td>
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-2">
                                    @employee.Departement
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group shadow-sm">
                                    <a asp-action="Details" asp-route-id="@employee.Id" class="btn btn-white btn-sm border" title="View">
                                        <i class="bi bi-eye text-primary"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@employee.Id" class="btn btn-white btn-sm border" title="Edit">
                                        <i class="bi bi-pencil text-secondary"></i>
                                    </a>
                                    @* Delete requires a form to be secure *@
                                    <button type="button" class="btn btn-white btn-sm border" title="Delete"
                                            data-bs-toggle="modal"
                                            data-bs-target="#confirmDeleteModal"
                                            data-bs-id="@employee.Id"
                                            data-bs-name="@employee.Name">
                                        <i class="bi bi-trash text-danger"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-people text-muted fs-1"></i>
                <p class="mt-2 text-muted">No employees found in the directory.</p>
            </div>
        }
    </div>
</div>

@await Html.PartialAsync("_DeleteConfirmationPartial", new DeleteModalViewModel
{
    ModalController = "Home",
    ModalAction = "DeleteEmployee",
    ModalId = "confirmDeleteModal",
    RouteId = "",
    ItemName = ""
})

@section Script {
    <script>
        // Instant Search Logic
        document.getElementById('employeeSearch').addEventListener('input', function () {
            const filter = this.value.toLowerCase();
            document.querySelectorAll('.employee-row').forEach(row => {
                const text = row.innerText.toLowerCase();
                row.classList.toggle('d-none', !text.includes(filter));
            });
        });
    </script>
}