@model EditViewModel

@{
    ViewBag.Title = "Edit Employee";
    var photoPath = "~/images/" + (Model.ExistingImagePath ?? "noimage.png");
}

<div class="mb-4 d-flex align-items-center justify-content-center" style="min-height: 100vh; background-color: #f8f9fa;">
    <div class="container" style="max-width: 500px;">
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white">

            <div class="text-center pt-5 px-4">
                <div class="position-relative d-inline-block mb-3">
                    <img id="profilePreview" src="@photoPath" asp-append-version="true"
                         class="rounded-circle border border-4 border-white shadow-sm"
                         style="width: 180px; height: 180px; object-fit: cover; background-color: #eee;"
                         alt="Profile Picture" />

                    <label for="photoInput" class="action-btn bg-primary text-white position-absolute shadow"
                           style="bottom: 5px; right: 5px; width: 40px; height: 40px; border-radius: 50%; border: 3px solid #fff; cursor: pointer; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-camera-fill"></i>
                    </label>

                    <button type="button" id="removeBtn" class="action-btn bg-danger text-white position-absolute shadow @(string.IsNullOrEmpty(Model.ExistingImagePath) ? "d-none" : "d-flex")"
                            style="top: 5px; right: 5px; width: 35px; height: 35px; border-radius: 50%; border: 3px solid #fff; cursor: pointer; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-trash-fill" style="font-size: 0.85rem;"></i>
                    </button>
                </div>

                <h4 class="fw-bold text-dark mb-1">Edit Profile</h4>
                <p class="text-muted small pb-3 border-bottom mx-4">Employee ID: #@Model.Id</p>
            </div>

            <div class="card-body px-4 pb-4">
                <form enctype="multipart/form-data" asp-controller="Home" asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ExistingImagePath" />
                    <input asp-for="Photo" id="photoInput" class="d-none" accept="image/*">
                    <input type="hidden" asp-for="IsImageRemoved" id="isImageRemoved" value="false" />

                    <div class="vstack gap-3">
                        <div>
                            <label class="form-label ls-wide fw-bold text-uppercase text-secondary" asp-for="Name"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person"></i></span>
                                <input class="form-control border-start-0 bg-light-subtle" asp-for="Name" />
                            </div>
                            <span class="text-danger x-small" asp-validation-for="Name"></span>
                        </div>

                        <div>
                            <label class="form-label ls-wide fw-bold text-uppercase text-secondary" asp-for="Email"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                                <input class="form-control border-start-0 bg-light-subtle" asp-for="Email" />
                            </div>
                            <span class="text-danger x-small" asp-validation-for="Email"></span>
                        </div>

                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label class="form-label ls-wide fw-bold text-uppercase text-secondary" asp-for="Departement"></label>
                                <select class="form-select bg-light-subtle" asp-for="Departement" asp-items="@Model.Departements">
                                    <option value="">Select Dept</option>
                                </select>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label ls-wide fw-bold text-uppercase text-secondary" asp-for="DateOfBirth">Birth Date</label>
                                <input class="form-control bg-light-subtle" asp-for="DateOfBirth" type="date" />
                            </div>
                        </div>

                        <div class="pt-3 d-grid gap-2">
                            <button type="submit" class="btn btn-primary py-2 fw-bold rounded-3 shadow-sm">
                                Save Profile Changes
                            </button>
                            <a asp-action="Index" class="btn btn-link text-secondary text-decoration-none small">
                                Cancel
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .ls-wide {
        letter-spacing: 0.06rem;
        font-size: 0.65rem;
    }

    .x-small {
        font-size: 0.75rem;
    }

    .action-btn {
        transition: all 0.2s ease;
        z-index: 5;
    }

        .action-btn:hover {
            transform: scale(1.1);
        }

    .input-group-text {
        border-color: #dee2e6;
    }

    .form-control:focus, .form-select:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.15);
    }
</style>

@section Script {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const photoInput = document.getElementById('photoInput');
        const preview = document.getElementById('profilePreview');
        const removeBtn = document.getElementById('removeBtn');
        const isRemovedHidden = document.getElementById('isImageRemoved');
        const defaultImg = "/images/noimage.png";

        // Handle File Selection (Upload)
        photoInput.addEventListener('change', function (e) {
            if (this.files && this.files[0]) {
                const reader = new FileReader();
                reader.onload = function (event) {
                    preview.src = event.target.result;
                    isRemovedHidden.value = "false"; // Don't delete if we just uploaded
                    removeBtn.classList.remove('d-none'); // Show trash button
                }
                reader.readAsDataURL(this.files[0]);
            }
        });

        // Handle Removal (Trash Icon)
        removeBtn.addEventListener('click', function () {
            preview.src = defaultImg;
            photoInput.value = ""; // Clear file input if any
            isRemovedHidden.value = "true"; // Tell the server to delete the file
            this.classList.add('d-none'); // Hide trash button
        });
    </script>
}