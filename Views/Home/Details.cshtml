@model DetailViewModel

@{
    ViewBag.Title = Model.PageTitle;
    var path = "~/Images/" + (Model.Employee.PhotoPath ?? "noimage.png");
}

<div class="container py-5">
    <div class="row g-4 justify-content-center">
        @* Left Side: Profile Photo & Key Info *@
        <div class="col-lg-4">
            <div class="card shadow-sm border-1 border-light-subtle text-center p-4">
                <div class="position-relative d-inline-block mx-auto mb-3">
                    <img src="@path" asp-append-version="true"
                         class="rounded-circle border shadow-sm"
                         style="width: 180px; height: 180px; object-fit: cover;"
                         alt="@Model.Employee.Name" />
                </div>
                <h4 class="mb-1">@Model.Employee.Name</h4>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill">
                    @Model.Employee.Departement
                </span>

                <div class="mt-4 d-grid gap-2">
                    <a asp-action="Edit" asp-controller="Home" asp-route-id="@Model.Employee.Id" class="btn btn-outline-secondary">
                        <i class="bi bi-pencil me-2"></i>Edit Profile
                    </a>
                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal">
                        <i class="bi bi-trash me-2"></i>Delete Employee
                    </button>
                </div>
            </div>
        </div>

        @* Right Side: Full Details Table *@
        <div class="col-lg-6">
            <div class="card shadow-sm border-1 border-light-subtle h-100">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <h5 class="mb-0">Employee Information</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3 pb-3 border-bottom">
                        <div class="col-sm-4 text-muted small text-uppercase fw-bold">Employee ID</div>
                        <div class="col-sm-8 fw-medium">#@Model.Employee.Id</div>
                    </div>
                    <div class="row mb-3 pb-3 border-bottom">
                        <div class="col-sm-4 text-muted small text-uppercase fw-bold">Email Address</div>
                        <div class="col-sm-8">
                            <a href="mailto:@Model.Employee.Email" class="text-decoration-none">@Model.Employee.Email</a>
                        </div>
                    </div>
                    <div class="row mb-3 pb-3 border-bottom">
                        <div class="col-sm-4 text-muted small text-uppercase fw-bold">Department</div>
                        <div class="col-sm-8">@Model.Employee.Departement</div>
                    </div>
                    <div class="row mb-0">
                        <div class="col-sm-4 text-muted small text-uppercase fw-bold">Date of Birth</div>
                        <div class="col-sm-8">@Model.Employee.DateOfBirth.ToString()</div>
                    </div>
                </div>
                <div class="card-footer bg-light border-0 py-3 text-end">
                    <a asp-controller="home" asp-action="index" class="btn btn-link text-secondary text-decoration-none">
                        <i class="bi bi-arrow-left me-1"></i> Back to Directory
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@* Call to the delete modal *@ 
@await Html.PartialAsync("_DeleteConfirmationPartial", new DeleteModalViewModel
{
    ModalController = "Home",
    ModalAction = "DeleteEmployee",
    ModalId = "confirmDeleteModal",
    RouteId = Model.Employee.Id.ToString(), // Ensure this is the ID!
    ItemName = Model.Employee.Name
})