@{
    ViewBag.Title = "Employee Not Found";
    var message = ViewBag.Message as string ?? "The requested employee could not be found.";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <!-- Image flush with card border -->
                <img src="~/images/404.png"
                     class="w-100 d-block"
                     style="height:250px; object-fit:cover;"
                     alt="Employee Not Found">

                <div class="card-body text-center p-4">
                    <h2 class="text-danger mb-3">Employee Not Found</h2>
                    <p class="lead mb-4">@message</p>

                    <a asp-controller="Home" asp-action="Index"
                       class="btn btn-primary btn-lg">
                        Back to Employee List
                    </a>

                    <hr class="my-4">

                    <p class="text-muted small">
                        Tip: You can search for another employee using their ID.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
