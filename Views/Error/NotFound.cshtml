@{
    ViewBag.Title = "404 Page Not Found";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <!-- Image flush with card border -->
                <img src="~/images/404.png"
                     class="w-100 d-block"
                     style="height:250px; object-fit:cover;"
                     alt="Page Not Found">
                <div class="card-body text-center p-4">
                    <h2 class="text-danger mb-3">404 - Page Not Found</h2>
                    <p class="lead mb-4">@ViewBag.ErrorMessage</p>
                    <a asp-controller="Home" asp-action="Index"
                       class="btn btn-primary btn-lg">
                        Back to Home
                    </a>
                    <hr class="my-4">
                    <p class="text-muted small">
                        Tip: Check the URL for mistakes or use the navigation menu to find what you're looking for.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
