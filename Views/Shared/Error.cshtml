@{
    ViewData["Title"] = "Error";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <!-- Image flush with card border -->
                <img src="~/images/error.png"
                     class="w-100 d-block"
                     style="height:250px; object-fit:cover;"
                     alt="Error Image">
                <div class="card-body text-center p-4">
                    <h2 class="text-danger mb-3">An Error Occurred</h2>
                    <p class="lead mb-4">Sorry, something went wrong while processing your request.</p>
                    <a asp-controller="Home" asp-action="Index"
                       class="btn btn-primary btn-lg">
                        Back to Home
                    </a>
                    <hr class="my-4">
                    <p class="text-muted small">
                        If the problem persists, please contact support at "aziz.rhmn93@gmail.com".
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

