@inject SignInManager<AppUser> signInManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <environment include="Development">
        <link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        <script src="~/lib/jquery/dist/jquery.js"></script>
        <script src="~/lib/jquery-validate/jquery.validate.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
    </environment>
    <environment exclude="Development">
        <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    </environment>

    <link href="~/css/CustomStyle.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />

    <title>@ViewBag.Title</title>

    <style>
        /* Small modern touches that are safe to include here */
        .brand-text { font-weight: 600; letter-spacing: 0.2px; }
        .avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: inline-block;
            background: var(--bs-secondary-bg, #6c757d);
            color: #fff;
            text-align: center;
            line-height: 36px;
            font-weight: 600;
        }
        .toast-container { position: fixed; top: 1rem; right: 1rem; z-index: 1080; }
        .navbar .form-control { min-width: 200px; }
        body.theme-dark { background-color: #0f1720; color: #e6eef6; }
        body.theme-dark .navbar { background-color: #071028 !important; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm sticky-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="home" asp-action="index" aria-label="Go to home">
                    <i class="bi bi-people-fill fs-4"></i>
                    <span class="brand-text">Team Manager</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu" aria-controls="mobileMenu" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav ms-auto align-items-center">

                        @if (signInManager.IsSignedIn(User) && User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown me-2">
                                <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-gear-fill"></i> Manage
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="adminDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Administration" asp-action="ListRoles">
                                            <i class="bi bi-shield-lock me-2"></i>Manage Roles
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Administration" asp-action="ListUsers">
                                            <i class="bi bi-people me-2"></i>Manage Users
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }


                        <li class="nav-item me-2">
                            <!-- desktop theme toggle (also marked with .theme-toggle so script binds to both) -->
                            <button id="themeToggle" class="btn btn-outline-light btn-sm theme-toggle" type="button" aria-pressed="false" aria-label="Toggle theme">
                                <i class="bi bi-sun-fill"></i>
                            </button>
                        </li>

                        @if (signInManager.IsSignedIn(User))
                        {
                            <li class="nav-item dropdown ms-lg-3">
                                @* Dropdown Trigger *@
                                <a class="nav-link dropdown-toggle d-flex align-items-center p-0 gap-2" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="bg-primary bg-gradient text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm"
                                         style="width: 38px; height: 38px; font-weight: 600; font-size: 0.85rem;">
                                        @User.Identity?.Name?.Substring(0, 1).ToUpper()
                                    </div>
                                </a>

                                @* Dropdown Menu *@
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2 py-0 overflow-hidden" aria-labelledby="userDropdown">

                                    @* User Info Header *@
                                    <li class="bg-light border-bottom px-3 py-3">
                                        <p class="text-muted mb-0 small fw-bold text-uppercase" style="letter-spacing: 0.05rem; font-size: 0.65rem;">Account</p>
                                        <p class="text-dark mb-0 fw-bold text-truncate" style="max-width: 160px;">@User.Identity?.Name</p>
                                    </li>

                                    @* Navigation Links *@
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-3 py-2 mt-2" asp-controller="Account" asp-action="DisplayProfile">
                                            <i class="bi bi-person-circle text-secondary"></i> Profile
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-3 py-2" asp-controller="Account" asp-action="Manage">
                                            <i class="bi bi-gear-wide-connected text-secondary"></i> Settings
                                        </a>
                                    </li>

                                    <li><hr class="dropdown-divider my-2"></li>

                                    @* Logout Button *@
                                    <li class="pb-2">
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item d-flex align-items-center gap-3 py-2 text-danger">
                                                <i class="bi bi-box-arrow-right"></i> Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a asp-controller="account" asp-action="Login" class="nav-link">Login</a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Account" asp-action="RegisterUser" class="nav-link">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Offcanvas mobile menu -->
        <div class="offcanvas offcanvas-start" tabindex="-1" id="mobileMenu" aria-labelledby="mobileMenuLabel">
            <div class="offcanvas-header">
                <h5 class="offcanvas-title" id="mobileMenuLabel">Menu</h5>
                <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body">
                <nav class="nav flex-column">
                    <a asp-controller="home" asp-action="index" class="nav-link">Team</a>
                    <a asp-controller="home" asp-action="create" class="nav-link">Create</a>
                    @if (signInManager.IsSignedIn(User) && User.IsInRole("Admin"))
                    {
                        <a asp-controller="Administration" asp-action="ListRoles" class="nav-link">Manage Roles</a>
                    }
                    <hr />
                    @if (signInManager.IsSignedIn(User))
                    {
                        <a asp-controller="Account" asp-action="Profile" class="nav-link">Profile</a>
                        <form asp-controller="account" asp-action="logout" method="post" class="mt-2">
                            <button type="submit" class="btn btn-outline-dark w-100">Logout</button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="account" asp-action="Login" class="nav-link">Login</a>
                        <a asp-controller="Account" asp-action="RegisterUser" class="nav-link">Register</a>
                    }
                    <div class="mt-3 d-grid">
                        <button id="themeToggleMobile" class="btn btn-outline-secondary theme-toggle" type="button" aria-pressed="false" aria-label="Toggle theme (mobile)">
                            <i class="bi bi-sun-fill"></i> Toggle theme
                        </button>
                    </div>
                </nav>
            </div>
        </div>
    </header>

    <main class="container flex-grow-1 mt-5" style="max-width:1100px">
        @RenderBody()
    </main>

    <footer class="bg-dark text-white border-top py-3 mt-auto">
        <div class="container d-flex flex-column flex-md-row align-items-center gap-2">
            <div class="d-flex gap-3">
                <a href="#" class="text-decoration-none text-white-50">Privacy</a>
                <a href="#" class="text-decoration-none text-white-50">Terms</a>
                <a href="#" class="text-decoration-none text-white-50">Contacts</a>
            </div>
            <small class="text-white-50 ms-md-auto text-md-end mt-2 mt-md-0">
                © 2025 | Built by Aziz Sheikh
            </small>
        </div>
    </footer>

    <!-- Toast container for transient messages -->
    <div class="toast-container position-fixed top-0 end-0 p-3">
        <div id="globalToast" class="toast" role="status" aria-live="polite" aria-atomic="true">
            <div class="toast-header">
                <strong class="me-auto">Notification</strong>
                <button type="button" class="btn-close ms-2 mb-1" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body">
                <span id="globalToastBody">Welcome back.</span>
            </div>
        </div>
    </div>

    <!-- jQuery / Validation -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Flatpickr JS -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/plugins/monthSelect/style.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/plugins/monthSelect/index.js"></script>

    <script src="~/js/employee-dob.js"></script>
    <script src="~/js/show-hide_password.js"></script>

    <script>
        (function () {
            // Theme toggle: persists in localStorage
            const themeToggles = Array.from(document.querySelectorAll('.theme-toggle'));
            const body = document.body;
            const stored = localStorage.getItem('theme') || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

            function updateToggleButtons(t) {
                themeToggles.forEach(btn => {
                    if (!btn) return;
                    btn.innerHTML = (t === 'dark') ? '<i class="bi bi-moon-fill"></i>' + (btn.classList.contains('btn-sm') ? '' : ' Toggle theme') : '<i class="bi bi-sun-fill"></i>' + (btn.classList.contains('btn-sm') ? '' : ' Toggle theme');
                    btn.setAttribute('aria-pressed', t === 'dark' ? 'true' : 'false');
                });
            }

            function applyTheme(t) {
                if (t === 'dark') {
                    body.classList.add('theme-dark');
                } else {
                    body.classList.remove('theme-dark');
                }
                updateToggleButtons(t);
            }

            applyTheme(stored);

            themeToggles.forEach(btn => {
                btn?.addEventListener('click', () => {
                    const next = body.classList.contains('theme-dark') ? 'light' : 'dark';
                    localStorage.setItem('theme', next);
                    applyTheme(next);
                });
            });


            // Example helper to show a toast from server-rendered flag (call via script or set a temp viewbag)
            window.showToast = function (message, title = 'Notification') {
                const toastEl = document.getElementById('globalToast');
                const toastBody = document.getElementById('globalToastBody');
                if (!toastEl || !toastBody) return;
                toastBody.textContent = message;
                toastEl.querySelector('.toast-header strong').textContent = title;
                const toast = new bootstrap.Toast(toastEl);
                toast.show();
            };

            // Auto-show a sample toast if ViewBag.ToastMessage is set
            @if (TempData["ToastMessage"] != null)
            {
                <text>
                    document.addEventListener('DOMContentLoaded', function() {
                        showToast('@TempData["ToastMessage"]'.replace(/'/g, "\\'"), 'Logged In');
                    });
                </text>
            }

            @if (TempData["Error"] != null)
            {
                <text>
                    document.addEventListener('DOMContentLoaded', function() {
                        showToast('@TempData["Error"]'.replace(/'/g, "\\'"), 'Unsuccessful Delete');
                    });
                </text>
            }
        })();
    </script>

    @RenderSection("Script", required: false)
</body>
</html>