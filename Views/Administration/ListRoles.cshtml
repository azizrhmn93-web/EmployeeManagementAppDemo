@using Microsoft.AspNetCore.Identity
@model IEnumerable<IdentityRole>

@{
    ViewBag.Title = "Role Management";
}

<div class="container py-4">
    @* Dashboard Header *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-0">Access Roles</h4>
            <p class="text-muted small mb-0">Define and manage the permission levels for your team.</p>
        </div>
        <a asp-action="CreateRole" asp-controller="Administration" class="btn btn-primary shadow-sm px-3">
            <i class="bi bi-shield-plus me-2"></i>Create Role
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="card shadow-sm border-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small text-uppercase">
                        <tr>
                            <th class="ps-4">Role Name</th>
                            <th>Internal ID</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var role in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary bg-opacity-10 text-primary rounded p-2 me-3">
                                            <i class="bi bi-shield-lock-fill"></i>
                                        </div>
                                        <span class="fw-bold text-dark">@role.Name</span>
                                    </div>
                                </td>
                                <td>
                                    <code class="small text-muted">@role.Id</code>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group shadow-sm bg-white rounded border">
                                        <a asp-action="EditRole" asp-controller="Administration" asp-route-id="@role.Id"
                                           class="btn btn-white btn-sm border-0 py-2" title="Edit Role Settings">
                                            <i class="bi bi-pencil-square text-secondary"></i>
                                        </a>
                                        <button type="button"
                                                class="btn btn-white btn-sm border-0 py-2"
                                                data-bs-toggle="modal"
                                                data-bs-target="#confirmDeleteModal"
                                                data-bs-id="@role.Id"
                                                data-bs-name="@role.Name"
                                                title="Delete Role">
                                            <i class="bi bi-trash text-danger"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        @* Empty State *@
        <div class="card shadow-sm border-0 text-center p-5">
            <div class="py-4">
                <i class="bi bi-shield-slash text-muted opacity-25" style="font-size: 4rem;"></i>
                <h5 class="mt-3">No roles created yet</h5>
                <p class="text-muted">Get started by creating the first security role for your application.</p>
                <a asp-action="CreateRole" class="btn btn-primary mt-2">
                    <i class="bi bi-plus-lg me-1"></i> Create New Role
                </a>
            </div>
        </div>
    }
</div>

@await Html.PartialAsync("_DeleteConfirmationPartial", new DeleteModalViewModel
{
    ModalController = "Administration",
    ModalAction = "DeleteRole",
    ModalId = "confirmDeleteModal",
    RouteId = "",
    ItemName = "{Name}" // This is just a placeholder
})
