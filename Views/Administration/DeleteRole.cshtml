@model DeleteRoleViewModel

@{
    ViewBag.Title = "Delete Role";
}

<div class="container mt-4">
    <div class="card shadow-sm mb-4">
        <div class="card-header py-3">
            <h5 class="m-0 font-weight-bold text-primary text-center">Delete Role</h5>
        </div>
        <div class="card-body text-center">
            <h4>Are you sure you want to delete the role: <strong>@Model.RoleName</strong>?</h4>
            <form asp-action="DeleteRole" asp-controller="Administration" method="post" class="mt-3">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="ListRoles" asp-controller="Administration" class="btn btn-secondary ms-2">Cancel</a>
            </form>
        </div>
    </div>
</div>
