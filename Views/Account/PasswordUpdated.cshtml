@{
    ViewBag.Title = "Password Reset Successful";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: 85vh;">
    <div class="container">
        <div class="row justify-content-center">
            @* Exact same width as your Login and Reset Password pages *@
            <div class="col-md-8 col-lg-6 col-xl-5">
                <div class="card shadow border-0 rounded-4">
                    <div class="card-body p-4 p-md-5 text-center">
                        @* Success Checkmark Icon *@
                        <div class="mb-4">
                            <div class="display-1 text-success">
                                <i class="bi bi-check-circle-fill"></i>
                            </div>
                        </div>

                        <h3 class="fw-bold mb-2">Password Updated!</h3>
                        <p class="text-muted mb-4">
                            Your password has been successfully reset. You can now use your new password to log in to your account.
                        </p>

                        <div class="d-grid">
                            <a asp-action="Login" asp-controller="Account" class="btn btn-primary btn-lg fw-bold">
                                Sign In Now
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>