@{
    ViewData["Title"] = "Account Locked";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: 80vh; background-color: #ffffff;">
    <div class="container" style="max-width: 450px;">
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">

            @* Header with Warning Icon *@
            <div class="text-center pt-5 pb-4 px-4">
                <div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-4"
                     style="width: 80px; height: 80px;">
                    <i class="bi bi-shield-lock text-danger" style="font-size: 2.5rem;"></i>
                </div>
                <h3 class="fw-bold text-dark">Account Locked</h3>
                <p class="text-muted small px-3">
                    For your security, this account has been temporarily disabled due to too many failed login attempts.
                </p>
            </div>

            <div class="card-body px-4 pb-5">
                @* Info Box *@
                <div class="alert alert-warning border-0 small py-3 shadow-sm mb-4">
                    <div class="d-flex">
                        <i class="bi bi-info-circle-fill me-2 mt-1"></i>
                        <span>You can try logging in again in <strong>20 minutes</strong>, or use the link below to regain access.</span>
                    </div>
                </div>

                <div class="vstack gap-2">
                    @* Action Buttons *@
                    <a asp-action="ForgotPassword" asp-controller="Account" class="btn btn-primary py-2 fw-bold rounded-3 shadow-sm">
                        Reset Password to Unlock
                    </a>

                    <a asp-action="Login" asp-controller="Account" class="btn btn-link text-secondary text-decoration-none extra-small fw-semibold text-center">
                        Back to Login
                    </a>
                </div>
            </div>

            @* Support Footer *@
            <div class="card-footer bg-light border-0 py-3 text-center">
                <span class="text-muted extra-small">
                    Still having trouble? <a href="mailto:support@yourdomain.com" class="text-primary text-decoration-none">Contact Support</a>
                </span>
            </div>
        </div>
    </div>
</div>

<style>
    .extra-small {
        font-size: 0.75rem;
    }
</style>