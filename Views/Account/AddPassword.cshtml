@model AddPasswordViewModel

@{
    ViewBag.Title = "Add Password";
}

<div class="pb-5 d-flex align-items-center justify-content-center" style="min-height: 100vh; background-color: #ffffff;">
    <div class="container" style="max-width: 500px;">

        <div class="card shadow-lg border-1 border-light-subtle rounded-4 overflow-hidden">

            @* Header Section - Security Focused *@
            <div class="text-center py-4 px-4 bg-white border-bottom border-light-subtle">
                <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 80px; height: 80px;">
                    <i class="bi bi-shield-lock text-primary fs-1"></i>
                </div>
                <h4 class="fw-bold text-dark mb-1">Security Settings</h4>
                <p class="text-muted small mb-0">Update your password to keep your account secure</p>
            </div>

            <div class="card-body px-4 px-md-5 py-3">
                <form asp-action="AddPassword" asp-controller="Account" method="post">
                    @* Centered Validation Summary *@
                    <div asp-validation-summary="All" class="text-danger small mb-4"></div>

                    <div class="vstack gap-4">


                        @* New Password *@
                        <div class="form-group">
                            <label asp-for="NewPassword" class="form-label small fw-bold text-uppercase text-secondary tracking-wider mb-1"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                                <input asp-for="NewPassword" class="form-control border-start-0 ps-0 bg-white" placeholder="Enter new password" />
                            </div>
                            <span asp-validation-for="NewPassword" class="text-danger extra-small"></span>
                        </div>

                        @* Confirm New Password *@
                        <div class="form-group">
                            <label asp-for="ConfirmPassword" class="form-label small fw-bold text-uppercase text-secondary tracking-wider mb-1"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-end-0 text-muted"><i class="bi bi-lock-check"></i></span>
                                <input asp-for="ConfirmPassword" class="form-control border-start-0 ps-0 bg-white" placeholder="Repeat new password" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger extra-small"></span>
                        </div>

                        @* Action Buttons *@
                        <div class="pt-3 d-grid gap-2">
                            <button type="submit" class="btn btn-primary py-2 fw-bold rounded-3 shadow-sm">
                                <i class="bi bi-arrow-repeat me-2"></i>Update Password
                            </button>
                            <a asp-action="DisplayProfile" class="btn btn-link text-secondary text-decoration-none small py-2">
                                Cancel and go back
                            </a>
                        </div>

                    </div>
                </form>
            </div>
        </div>

        @* Optional Security Tip *@
        <div class="text-center mt-4">
            <p class="text-muted small">
                <i class="bi bi-info-circle me-1"></i>
                Strong passwords include a mix of letters, numbers, and symbols.
            </p>
        </div>
    </div>
</div>

<style>
    /* Consistency with your other styles */
    .tracking-wider {
        letter-spacing: 0.08rem;
        font-size: 0.7rem;
    }

    .extra-small {
        font-size: 0.75rem;
    }

    .input-group-text {
        border-color: #dee2e6;
    }

    .form-control:focus {
        border-color: #0d6efd;
        box-shadow: none;
    }

    /* Perfecting the rounded corners on input groups */
    .input-group-text {
        border-radius: 0.5rem 0 0 0.5rem !important;
    }

    .form-control {
        border-radius: 0 0.5rem 0.5rem 0 !important;
    }
</style>