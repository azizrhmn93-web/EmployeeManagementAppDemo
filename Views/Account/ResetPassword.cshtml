@model ResetPasswordViewModel

@{
    ViewBag.Title = "Reset Password";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: 85vh;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6 col-xl-5">
                <div class="card shadow border-0 rounded-4">
                    <div class="card-body p-4 p-md-5">
                        <div class="mb-4">
                            <h3 class="fw-bold mb-1">Reset Password</h3>
                            <p class="text-muted small">Enter your new password below to regain access to your account.</p>
                        </div>

                        <form asp-action="ResetPassword" asp-controller="Account" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                            @* Hidden fields are required for the Reset Password logic to work *@
                            <input asp-for="Email" type="hidden" />
                            <input asp-for="Token" type="hidden" />

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label fw-medium small mb-1">New Password</label>
                                <div class="position-relative">
                                    <input asp-for="Password" type="password" class="form-control border-2 pe-5 password-input" />
                                    <span class="toggle-password position-absolute top-50 end-0 translate-middle-y me-3 text-muted">
                                        <i class="bi bi-eye-slash-fill" style="cursor: pointer;"></i>
                                    </span>
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="ConfirmPassword" class="form-label fw-medium small mb-1">Confirm New Password</label>
                                <div class="position-relative">
                                    <input asp-for="ConfirmPassword" type="password" class="form-control border-2 pe-5 password-input" />
                                    <span class="toggle-password position-absolute top-50 end-0 translate-middle-y me-3 text-muted">
                                        <i class="bi bi-eye-slash-fill" style="cursor: pointer;"></i>
                                    </span>
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>

                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary btn-lg fw-bold">Update Password</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>